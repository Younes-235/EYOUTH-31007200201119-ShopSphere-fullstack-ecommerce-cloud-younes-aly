# ==============================================================================
# MAIN BACKEND ENVIRONMENT VARIABLES (Cloud / Production)
# ==============================================================================

PORT=5000
JWT_SECRET=your_super_secret_jwt_key_here

# PostgreSQL / Supabase Database Connection
DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"

# MongoDB Atlas Connection (Activity Audit Logs)
MONGO_URI="mongodb+srv://<username>:<password>@<cluster-name>.mongodb.net/shopsphere_db?retryWrites=true&w=majority&appName=Cluster0"

# Review Microservice URL (Deployed on Vercel)
REVIEW_SERVICE_URL="https://shopsphere-review-service-xxx.vercel.app"

# Serverless Email Function Endpoint (Deployed on Vercel)
SERVERLESS_EMAIL_URL="https://shopsphere-serverless-email-xxx.vercel.app/api/send-welcome-email"

# Frontend Application URL (CORS)
FRONTEND_URL="https://fullstack-ecommerce-cloud-younes-al-five.vercel.app"